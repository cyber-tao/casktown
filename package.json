{
  "name": "casktown.v2.glm",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "bun test",
    "preview": "vite preview",
    "sprites:repair": "bun run scripts/repair-sprite-atlases.ts",
    "sprites:refresh": "bun run scripts/generate-runtime-visual-assets.ts && bun run scripts/repair-sprite-atlases.ts && bun run scripts/refresh-sprites.ts",
    "voices:sync": "bun run scripts/sync-voice-lines.ts",
    "voices:generate": "bun run scripts/generate_voices.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "sharp": "^0.34.5"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@types/node": "^25.9.1",
    "phaser": "4.1.0",
    "vite": "^8.0.13"
  }
}
